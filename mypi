#!/bin/sh
mypi_script=$0
while [ -L "$mypi_script" ]; do
  mypi_link=$(readlink "$mypi_script")
  case "$mypi_link" in
    /*) mypi_script=$mypi_link ;;
    *) mypi_script=$(dirname -- "$mypi_script")/$mypi_link ;;
  esac
done
mypi_root=$(CDPATH= cd -- "$(dirname -- "$mypi_script")" && pwd)
if [ ! -x "$mypi_root/agent-workflow-v2/.venv/bin/python" ]; then
  printf 'mypi\047s private Python environment is missing here. Run: cd "%s" && ./install.sh\nGlobal Python/npm alone are not enough: wait for "Installed mypi". Requires Python 3.12+ and Node 22.19+. Run the installer without sudo.\n' "$mypi_root" >&2
  exit 1
fi
exec "$mypi_root/agent-workflow-v2/.venv/bin/python" "$mypi_root/pi_local.py" "$@"
